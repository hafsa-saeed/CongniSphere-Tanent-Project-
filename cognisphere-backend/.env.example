# ============================
# SERVER
# ============================
NODE_ENV=development
PORT=5000

# ============================
# DATABASE
# ============================
MONGO_URI=mongodb://127.0.0.1:27017/cognisphere

# ============================
# DOMAIN / MULTI-TENANCY
# ============================
# The root domain used to detect tenant subdomains.
# e.g. acme.cognisphere.com -> subdomain = "acme"
ROOT_DOMAIN=cognisphere.com
# Comma separated list of subdomains that are treated as "no tenant" (super admin / marketing site)
RESERVED_SUBDOMAINS=app,www,admin,api

# ============================
# AUTH / JWT
# ============================
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# ============================
# CORS
# ============================
CLIENT_URL=http://localhost:3000

# ============================
# FILE STORAGE (S3 / Cloudflare R2)
# ============================
# Leave ALL of these blank/unset to use local-disk storage under
# /public/uploads (zero setup, good for local dev).
# Set S3_BUCKET_NAME + S3_ACCESS_KEY_ID + S3_SECRET_ACCESS_KEY to switch
# the upload.controller.js / certificate generator to S3 or R2 automatically.
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Only needed for S3-compatible providers that are NOT AWS, e.g. Cloudflare R2:
# https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Public base URL to serve files from (custom domain / CDN in front of the bucket).
# Required for R2 since R2 buckets have no public URL by default.
S3_PUBLIC_URL_BASE=

# ============================
# AI (AI Quiz Architect + CogniCopilot)
# ============================
# Real backend AI calls — used by POST /quizzes/generate-draft (AI Quiz
# Architect) and POST /copilot/chat (CogniCopilot). Get a FREE key at
# https://aistudio.google.com/apikey (no prepaid credits required, unlike
# Anthropic's $5 minimum). Without this set, both features return a clear
# 503 error instead of failing silently or falling back to fake output.
GEMINI_API_KEY=AQ.Ab8RN6KBq6jt79Tp9m0YPCJT5nwSH7M8dDoIWXeeS1dEMfbNiw;
