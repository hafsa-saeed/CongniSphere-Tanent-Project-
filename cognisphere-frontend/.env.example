# The backend host + port WITHOUT protocol or subdomain, e.g. "localhost:5000".
# The API base URL is built dynamically at runtime as:
#   http://<detected-subdomain>.<VITE_API_HOST>/api/v1   (tenant subdomains)
#   http://<VITE_API_HOST>/api/v1                          (root/super-admin)
VITE_API_HOST=localhost:5000

# The root domain used to detect a tenant subdomain from the browser URL.
# Must match the backend's ROOT_DOMAIN. Use "localhost" for local dev with
# hosts like acme.localhost:3000.
VITE_ROOT_DOMAIN=localhost
